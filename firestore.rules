rules_version = '2';

// Reglas para TapOut.
// - /rooms/{roomId}: modo multijugador en vivo. Solo guarda los picks del
//   draft (sin datos personales sensibles), así que se permite lectura/
//   escritura abierta a quien tenga el código de la sala.
// - /users/{userKey}: tus rankings/tiers personales, sincronizados entre
//   tus dispositivos por nombre (sin contraseña, igual que el login de la
//   app). userKey es tu nombre en minúsculas, así que cualquiera que
//   adivine tu nombre podría leer/editar tus rankings — mismo modelo de
//   confianza que el código de sala. Si quieres más control, añade
//   autenticación anónima (signInAnonymously) y valida request.auth aquí.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read, write: if true;
    }
    match /users/{userKey} {
      allow read, write: if true;
    }
  }
}
